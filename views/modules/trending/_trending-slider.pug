.trending-slider-section
  h2.heading.trending-slider-heading Trending Podcast
  .trending-slider
    .trending-slider-list
      .trending-slide.trending-slide--side
        img.trending-slide-img(src="https://images.unsplash.com/photo-1516035069371-29a1b244cc32?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80", alt="camera setup")
      .trending-slide.trending-slide--main
        .trending-slide-content
          h3.trending-slide-title Don't Always Win | LifeSpring
          p.trending-slide-episode Podcast Episode - 1
          p.trending-slide-author Yahia Md Amin ( Chairman - LifeSpring Limited )
          button.button.button--primary.trending-slide-btn(type="button")
            include ../../icons/_icon-play
            span Play Now
        .trending-slide-media
          img(src="https://images.unsplash.com/photo-1590602847861-f357a9332bbc?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80", alt="microphone")
      .trending-slide.trending-slide--gradient
        .trending-slide-content
          h3.trending-slide-title Keep Moving. Don't Look Back...
          p.trending-slide-episode Podcast Episode - 1
          p.trending-slide-author Yahia Md Amin ( Chairman - LifeSpring Limited )
          button.button.trending-slide-btn.trending-slide-btn--white(type="button")
            include ../../icons/_icon-play
            span Play Now
    .trending-slider-dots
      span.slider-dot
      span.slider-dot
      span.slider-dot.is-active
      span.slider-dot
      span.slider-dot
