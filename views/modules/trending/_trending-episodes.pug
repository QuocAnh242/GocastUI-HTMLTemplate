.trending-episodes-section
  .trending-filter-bar
    .trending-tabs
      button.trending-tab(type="button") All
      button.trending-tab(type="button") Shows
      button.trending-tab.is-active(type="button") Episodes
  .trending-section-header
    .trending-section-info
      h3.heading.trending-section-title Trending epsides
      p.trending-section-desc The Most Popula Podcast episodes overall now. Last updated 2 hours ago
    .trending-dropdown
      button.trending-dropdown-btn(type="button")
        span Last 1 Weeks
        svg(width="12" height="8" viewBox="0 0 12 8" fill="none")
          path(d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round")
  .trending-episodes-grid
    each ep in trendingList
      +trendingEpisodeCard(ep)
